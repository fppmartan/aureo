<Window x:Class="Aureo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aureo"
        mc:Ignorable="d"
        Title="Aureo" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: Top bar -->
            <RowDefinition Height="*"/>
            <!-- Row 1: Center content -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Floating bottom dock -->
        </Grid.RowDefinitions>

        <!-- Row 0: Top Bar-->
        <Border Grid.Row="0"
                Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="42,14">

            <Button HorizontalAlignment="Left" 
                    Width="40" 
                    Height="40"
                    Background="Transparent" BorderThickness="0" 
                    Cursor="Hand" Command="{Binding NavigateCommand}"
                    CommandParameter="Profile">

                <!-- Circular avatar badge -->
                <Border Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="{DynamicResource AccentBrush}">

                    <TextBlock Text="U"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BackgroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

            </Button>
        </Border>
        
        <!-- Row 1: Dynamic Center Area -->
        <Grid Grid.Row="1">
            
            <!-- Home State -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">

                        <!-- Hidden by default -->
                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                        <Style.Triggers>
                            <!-- Shown only when CurrentSection == "Home" -->
                            <DataTrigger Binding="{Binding CurrentSection}" Value="Home">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                </StackPanel.Style>

                <TextBlock Text="{Binding GreetingMessage}"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SmartAlertMessage}"
                           FontSize="16"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>

            </StackPanel>
            
            <!-- Placeholder for other tabs -->
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility"
                                Value="Visible"/>
                        <Style.Triggers>

                            <!-- Hidden when Home is active -->
                            <DataTrigger Binding="{Binding CurrentSection}"
                                         Value="Home">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{Binding CurrentSection}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Under development."
                           FontSize="14"
                           Margin="0,8,0,20"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <Button Content="Back to Home"
                        Padding="16,8"
                        Cursor="Hand"
                        Background="{DynamicResource CardSurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Home"
                        HorizontalAlignment="Center"/>

            </StackPanel>

        </Grid>
        
        <!-- Row 2: Floating Pill Dock -->
        
        <Border Grid.Row="2"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                CornerRadius="28"
                Padding="16,10"
                Background="{DynamicResource CardSurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1">

            <StackPanel
                Orientation="Horizontal">

                <Button Content="INCOME" 
                        Margin="8,0" 
                        Padding="14,8"
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Income">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="Income">
                                    <Setter Property="Foreground" Value="{DynamicResource IncomeBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="GENERAL VIEW" 
                        Margin="8,0" 
                        Padding="14,8"
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="GeneralView">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="GeneralView">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="OUTCOME" 
                        Margin="8,0" 
                        Padding="14,8"
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Command="{Binding NavigateCommand}" 
                        CommandParameter="Outcome">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="Outcome">
                                    <Setter Property="Foreground" Value="{DynamicResource OutcomeBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
            </StackPanel>
            
        </Border>
                    
    </Grid>

</Window>
