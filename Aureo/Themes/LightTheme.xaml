<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 
    Colors use #AARRGGBB (AA = opacity). 
    Keep all x:Key values identical across themes 
    -->

    <!-- Surface & Typography -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF5EFE6"/>
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#B3FFFDF9"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF3B2F2F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF7A6A5D"/>

    <!-- Semantic Highlights -->
    <SolidColorBrush x:Key="IncomeBrush" Color="#FF2E7D5B"/>
    <SolidColorBrush x:Key="OutcomeBrush" Color="#FFC94A4A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFC88A2E"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#265C4B3B"/>

</ResourceDictionary>